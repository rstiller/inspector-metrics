{
    "name": "monorepo",
    "version": "0.0.0",
    "private": true,
    "packageManager": "pnpm@11.24.0",
    "devDependencies": {
        "@biomejs/biome": "2.5.11",
        "@testdeck/mocha": "0.3.3",
        "@types/async": "^3.2.25",
        "@types/chai": "^5.2.3",
        "@types/lodash": "^4.17.25",
        "@types/mocha": "^10.0.10",
        "@types/node": "^22.20.1",
        "@types/sinon": "^22.0.0",
        "@types/sinon-chai": "^4.0.0",
        "c8": "^12.0.0",
        "chai": "^6.2.2",
        "lodash": "^4.18.1",
        "mocha": "^11.8.0",
        "nock": "^14.0.17",
        "reflect-metadata": "0.2.2",
        "rimraf": "^6.1.3",
        "sinon": "^22.1.0",
        "sinon-chai": "^4.0.1",
        "tsx": "^4.23.12",
        "typescript": "^7.0.2"
    },
    "scripts": {
        "build": "pnpm run --recursive build",
        "clean": "pnpm run --recursive clean && rimraf coverage docs .pnpm-store",
        "compile": "pnpm run --recursive compile",
        "coverage": "c8 pnpm run --recursive test",
        "deps": "pnpm run --recursive deps",
        "lint": "pnpm run --recursive lint",
        "pretest": "pnpm run --recursive --filter inspector-metrics compile",
        "publishDocs": "cd docs && git add --all . && git commit -nm 'Deploy to gh-pages' && git push origin gh-pages && cd ..",
        "prepublishDocs": "bash test-env/compose.sh run --rm docs",
        "test": "pnpm run --recursive test"
    },
    "compodoc": {
        "tsconfig": "./tsconfig.docs.json",
        "output": "./docs",
        "disableGraph": true,
        "includes": "./",
        "includeNames": "READMEs",
        "unitTestCoverage": "./coverage/coverage-summary.json"
    },
    "c8": {
        "include": [
            "packages/*/lib/*.ts",
            "packages/*/lib/**/*.ts"
        ],
        "exclude": [
            "packages/*/test/*"
        ],
        "extension": [
            ".ts"
        ],
        "reporter": [
            "json-summary"
        ],
        "all": true
    },
    "dependencies": {
        "dayjs": "^1.11.23"
    }
}
