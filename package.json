{
    "name": "monorepo",
    "version": "0.0.0",
    "private": true,
    "packageManager": "pnpm@11.22.0",
    "devDependencies": {
        "@testdeck/mocha": "0.3.3",
        "@types/async": "^3.2.25",
        "@types/chai": "^4.3.20",
        "@types/chai-string": "^1.4.5",
        "@types/lodash": "^4.17.25",
        "@types/mocha": "^10.0.10",
        "@types/node": "^20.19.0",
        "@types/sinon": "^10.0.20",
        "@types/sinon-chai": "^3.2.12",
        "chai": "^4.3.7",
        "chai-string": "^1.5.0",
        "eslint": "^9.30.0",
        "globals": "^16.2.0",
        "lodash": "^4.17.21",
        "mocha": "^11.3.0",
        "moment": "2.30.1",
        "nock": "^14.0.0",
        "nyc": "^15.1.0",
        "reflect-metadata": "0.2.2",
        "rimraf": "^5.0.1",
        "sinon": "^15.2.0",
        "sinon-chai": "^3.7.0",
        "standard": "17.1.2",
        "testdouble": "^3.20.2",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.67.0"
    },
    "scripts": {
        "build": "pnpm run --recursive build",
        "clean": "pnpm run --recursive clean && rimraf coverage docs .pnpm-store",
        "compile": "pnpm run --recursive compile",
        "coverage": "nyc pnpm run --recursive test",
        "deps": "pnpm run --recursive deps",
        "lint": "pnpm run --recursive lint",
        "pretest": "pnpm run --recursive --filter inspector-metrics compile",
        "publishDocs": "cd docs && git add --all . && git commit -nm 'Deploy to gh-pages' && git push origin gh-pages && cd ..",
        "prepublishDocs": "bash test-env/compose.sh run --rm docs",
        "test": "pnpm run --recursive test"
    },
    "compodoc": {
        "tsconfig": "./tsconfig.docs.json",
        "output": "./docs",
        "disableGraph": true,
        "includes": "./",
        "includeNames": "READMEs",
        "unitTestCoverage": "./coverage/coverage-summary.json"
    },
    "nyc": {
        "include": [
            "packages/*/lib/*.ts",
            "packages/*/lib/**/*.ts"
        ],
        "exclude": [
            "packages/*/test/*"
        ],
        "extension": [
            ".ts"
        ],
        "require": [],
        "reporter": [
            "json-summary"
        ],
        "all": true
    }
}
